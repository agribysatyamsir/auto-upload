# Isko .env banao aur values bharo. .env gitignore me hai.

# ── LLM (script + keywords + metadata) ──
GOOGLE_API_KEY=            # AI Studio se — OAuth se ALAG cheez hai

# ── YouTube upload ──
# client_id / client_secret → client_secrets.json me hain
# refresh_token → token.json me (tools/get_refresh_token.py se)
# Production me yeh teeno Cloudflare Workers KV / GitHub Secrets me jaate hain
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── Footage ──
PEXELS_API_KEY=
PIXABAY_KEY=               # optional fallback

# ── LLM fallback ──
GROQ_API_KEY=              # optional

# ── Notifications ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Settings ──
NICHE=hindi_general
LANG=hi
VOICE=hi-IN-MadhurNeural
PRIVACY_STATUS=unlisted
